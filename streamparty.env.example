# /etc/streamparty.env
# Copy this file to /etc/streamparty.env on the VPS.
# Set correct values before starting the service.
# Permissions: chmod 600 /etc/streamparty.env

PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=streamparty
DB_PASS=CHANGE_THIS_DB_PASSWORD
DB_NAME=streamparty

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES=7d

UPLOAD_DIR=/var/www/streamparty/uploads
ORIGIN=https://watch.relay.media

# WebSocket ping interval (ms)
PING_MS=20000

# Max guests per room (hard cap)
MAX_GUESTS=50

# Room cleanup TTL after host disconnects (ms)  4 hours
ROOM_TTL_MS=14400000
